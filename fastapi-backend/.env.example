# =============================================================================
# FastAPI Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# This file contains all environment variables needed for the FastAPI backend

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Security Settings
# =============================================================================
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=*

# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Database Direct Connection
# Get these from your Supabase project database settings
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_PORT=5432

# =============================================================================
# Qdrant Vector Database Configuration
# =============================================================================
# Qdrant Cloud URL and API key
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# =============================================================================
# AWS Bedrock Configuration (for embeddings and RAG)
# =============================================================================
# AWS credentials for Bedrock access
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# =============================================================================
# Bedrock Model Configuration
# =============================================================================
# Bedrock model for RAG responses
BEDROCK_RAG_MODEL=openai.gpt-oss-20b-1:0
# Bedrock model for embeddings
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# =============================================================================
# Performance & Monitoring Settings
# =============================================================================
# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
# Maximum request size in bytes (50MB default)
MAX_REQUEST_SIZE=52428800
# Slow request threshold in seconds
SLOW_REQUEST_THRESHOLD=1.0

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Legacy Service Keys (for backward compatibility)
# =============================================================================
# These are kept for compatibility but not used in the unified FastAPI backend
CRAWLER_SERVICE_KEY=your-crawler-secret-key
PARSER_SERVICE_KEY=your-parser-secret-key
EMBEDDINGS_SERVICE_KEY=your-embedding-secret-key
RAG_SERVICE_KEY=your-rag-secret-key
REALTIME_CRAWL_SERVICE_KEY=your-secret-key

# =============================================================================
# Legacy Service URLs (for reference only)
# =============================================================================
# These URLs are not used in the unified backend but kept for reference
CRAWLER_SERVICE_URL=http://localhost:8001
PARSER_SERVICE_URL=http://localhost:8002
EMBEDDINGS_SERVICE_URL=http://localhost:8003
RAG_SERVICE_URL=http://localhost:8004
REALTIME_CRAWL_SERVICE_URL=http://localhost:8005